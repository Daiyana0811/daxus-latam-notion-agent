  "type": "commonjs",
  "dependencies": {
    "@notionhq/client": "^5.21.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.0.0",
    "playwright": "^1.60.0"
  }
