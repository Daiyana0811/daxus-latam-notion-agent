{
  "name": "daxus-latam-notion-agent",
  "version": "1.0.0",
  "description": "Scheduled Daxus LATAM course scraper and Notion database sync agent.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js && node --check scraper.js && node --check notion.js && node --check transcription.js && node --check scripts/count-pending-transcriptions.js",
    "transcribe:test": "node transcription.js \"Liderazgo Personal\"",
    "transcribe:api": "node transcription.js \"Liderazgo Personal\"",
    "transcribe:upload": "node transcription.js \"Liderazgo Personal\" --upload-notion",
    "transcribe:all": "node transcription.js --all --upload-notion",
    "transcribe:metadata": "node transcription.js \"Liderazgo Personal\" --metadata-only"
  },
